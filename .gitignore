# ---------------------------------------------------------------
# Rust
# ---------------------------------------------------------------
target/
**/*.rs.bk
*.pdb
# Cargo.lock is intentionally tracked: NovaVault ships a binary.

# ---------------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
coverage/
.pnpm-store/
*.tsbuildinfo
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------
# Tauri
# ---------------------------------------------------------------
src-tauri/target/
src-tauri/gen/schemas/
# Regenerated by build.rs from the command list on every build.
src-tauri/permissions/autogenerated/
src-tauri/WixTools/

# ---------------------------------------------------------------
# Environment and secrets — never commit these
# ---------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# ---------------------------------------------------------------
# Vault files — user data must never enter the repository
# ---------------------------------------------------------------
*.novavault
*.nvault
*.vault
*.vault.bak
vault/

# ---------------------------------------------------------------
# OS
# ---------------------------------------------------------------
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
