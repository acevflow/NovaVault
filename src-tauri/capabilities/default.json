{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window: only the NovaVault vault commands. No core plugin permissions (no events, file system, shell or HTTP). Grant anything else only when a feature needs it, and justify it in the PR.",
  "windows": ["main"],
  "permissions": [
    "allow-vault-status",
    "allow-create-vault",
    "allow-unlock",
    "allow-lock",
    "allow-change-master-password",
    "allow-regenerate-recovery-code",
    "allow-get-settings",
    "allow-set-auto-lock-timeout",
    "allow-set-clipboard-clear-delay",
    "allow-list-items",
    "allow-get-item",
    "allow-reveal-item-field",
    "allow-copy-item-field",
    "allow-create-item",
    "allow-update-item",
    "allow-delete-item"
  ]
}
